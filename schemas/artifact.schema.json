{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordito.dev/schemas/artifact.schema.json",
  "title": "ORDITO Contractual Artifact",
  "description": "Common logical schema for every ORDITO artifact. Every artifact must conform to this schema, regardless of the tool that hosts it (Jira, Notion, file system, knowledge base). This schema is the regularity of the warp: the minimum fields that allow the weft to pass without ambiguity.",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "owner_role",
    "status",
    "objective",
    "last_reviewed_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "Unique identifier. Recommended pattern: TYPE-YYYY-NNN",
      "pattern": "^[A-Z]+-\\d{4}-\\d{3,}$",
      "examples": ["INIT-2026-014", "FRQ-2026-103", "BRIEF-2026-067"]
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "initiative_charter",
        "feature_request",
        "feature_brief_pack",
        "design_spec",
        "technical_design_note",
        "tracking_plan",
        "release_checklist",
        "impact_review",
        "opportunity_brief",
        "exploration_report",
        "mvp_frame",
        "mvp_decision_review"
      ]
    },
    "owner_role": {
      "type": "string",
      "enum": [
        "sponsor",
        "product_lead",
        "ux_lead",
        "engineering_lead",
        "qa_release_lead",
        "data_analytics",
        "staff_engineer",
        "founder"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "ready_for_gate",
        "ready_for_g1",
        "ready_for_g2",
        "ready_for_release",
        "approved",
        "rejected",
        "archived",
        "in_progress",
        "final"
      ]
    },
    "gate_stage": {
      "type": "string",
      "enum": ["G0", "G1", "G2", "release", "learning"],
      "description": "Gate at which this artifact was produced or reviewed"
    },
    "upstream_refs": {
      "type": "array",
      "description": "References to artifacts that generated this one (upstream)",
      "items": { "type": "string", "pattern": "^[A-Z]+-\\d{4}-\\d{3,}$" }
    },
    "downstream_refs": {
      "type": "array",
      "description": "References to artifacts generated by this one (downstream)",
      "items": { "type": "string", "pattern": "^[A-Z]+-\\d{4}-\\d{3,}$" }
    },
    "objective": {
      "type": "string",
      "description": "What this artifact represents in one sentence",
      "minLength": 20,
      "maxLength": 500
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC\\d+$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "risk_band": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "telemetry_plan": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": { "type": "string" }
        },
        "kpis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "baseline": { "type": ["string", "number", "null"] },
              "target": { "type": ["string", "number", "null"] },
              "measurement": { "type": "string" }
            }
          }
        },
        "dashboard_url": { "type": "string", "format": "uri" }
      }
    },
    "decision_log": {
      "type": "array",
      "description": "Tracked overrides and significant decisions",
      "items": {
        "type": "object",
        "required": ["timestamp", "decision", "rationale", "owner"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 full timestamp, e.g. 2026-03-08T10:00:00Z"
          },
          "decision": { "type": "string" },
          "rationale": { "type": "string" },
          "owner": {
            "type": "string",
            "description": "Role identifier, e.g. product_lead (not handle @product.lead)"
          },
          "ai_service_overridden": {
            "type": "string",
            "description": "If the decision is an override of an AI service, the canonical service name"
          }
        }
      }
    },
    "ai_services_used": {
      "type": "array",
      "description": "AI services that contributed to producing this artifact",
      "items": {
        "type": "object",
        "required": ["service_name", "invoked_at"],
        "properties": {
          "service_name": {
            "type": "string",
            "enum": [
              "intake-coach",
              "prioritization-copilot",
              "brief-builder",
              "research-synthesizer",
              "design-critic",
              "solution-mapper",
              "code-review-agent",
              "test-case-generator",
              "release-verifier",
              "dashboard-narrator",
              "dependency-mapper",
              "compliance-checker"
            ]
          },
          "invoked_at": { "type": "string", "format": "date-time" },
          "model_used": {
            "type": "string",
            "description": "Model identifier in canonical form, e.g. claude-sonnet-4-6"
          },
          "human_reviewer": { "type": "string" }
        }
      }
    },
    "last_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
